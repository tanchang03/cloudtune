<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- 出站网络：调用网盘接口、拉取音频直流都依赖它。
	     Flutter 模板默认**不含**这一项，缺了会在沙箱里静默失败。 -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Keychain Sharing：flutter_secure_storage 在 macOS 上必需。
	     缺了它钥匙串写入报 -34018 (errSecMissingEntitlement)，凭证只能
	     降级到内存 → 每次启动都要重新登录。Release.entitlements 同步。 -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.cloudtune.cloudtune</string>
	</array>
</dict>
</plist>
