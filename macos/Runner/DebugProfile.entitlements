<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- 出站网络：调用网盘接口、拉取音频直流都依赖它。
	     Flutter 模板默认**不含**这一项，缺了会在沙箱里静默失败。 -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- ⛔ 这里**不要**加 keychain-access-groups。
	     它属于「需要描述文件的能力项」：一旦写上，Xcode 就要求
	     provisioning profile，而本仓库刻意走手动 / ad-hoc 签名
	     （CODE_SIGN_IDENTITY = "-"，DEVELOPMENT_TEAM 为空），
	     构建会直接失败："Runner" requires a provisioning profile.
	     钥匙串能否使用与它无关 —— 见 SecureCredentialStore：那里关掉了
	     useDataProtectionKeyChain，走传统钥匙串（只依赖代码签名，不需要
	     任何 entitlement），-34018 因此不会发生。
	     Release.entitlements 同步。 -->
</dict>
</plist>
